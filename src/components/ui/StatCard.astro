---
interface Props {
  label: string;
  valueId?: string;
  valueClass?: string;
  value?: string | number;
}

const { label, valueId, valueClass = 'text-white', value } = Astro.props as Props;
---

<div class="card stat-card min-w-0 p-4 sm:p-5">
  <p class="text-gray-400 text-xs font-medium uppercase tracking-wider leading-snug">{label}</p>
  {valueId ? (
    <p id={valueId} class={`stat-card-value font-bold mt-2 leading-tight tabular-nums whitespace-nowrap ${valueClass}`}>{value ?? '-'}</p>
  ) : (
    <p class={`stat-card-value font-bold mt-2 leading-tight tabular-nums whitespace-nowrap ${valueClass}`}>{value ?? '-'}</p>
  )}
</div>

<style>
  .stat-card {
    container-type: inline-size;
  }

  .stat-card-value {
    font-size: clamp(1.125rem, 13cqw, 1.875rem);
  }
</style>
