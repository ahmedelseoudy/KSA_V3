---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import StatCard from '../components/ui/StatCard.astro';

const user = Astro.locals.user;
const profile = (user as any)?.profile;

if (!profile || !['admin', 'super_admin'].includes(profile.role)) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Purchase Orders - KSA CRM">
  <div class="max-w-7xl mx-auto">
    <PageHeader
      title="Purchase Orders"
      subtitle="Follow every company from availability response through confirmation and delivery"
    />

    <div class="sticky top-0 z-20 -mx-1 px-1 py-2 bg-gray-950/80 backdrop-blur mb-4">
      <div class="flex flex-wrap items-end gap-3 bg-gray-800/60 border border-gray-700/60 rounded-xl p-3">
        <div>
          <label for="companyFilter" class="block text-xs text-gray-500 mb-1">Company</label>
          <select id="companyFilter" class="input min-w-[12rem]">
            <option value="">All companies</option>
          </select>
        </div>
        <div>
          <label for="statusFilter" class="block text-xs text-gray-500 mb-1">PO status</label>
          <select id="statusFilter" class="input min-w-[11rem]">
            <option value="">All statuses</option>
            <option value="draft">Draft</option>
            <option value="sent">Sent</option>
            <option value="confirmed">Confirmed</option>
            <option value="partially_delivered">Partially delivered</option>
            <option value="delivered">Delivered</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
        <button id="refreshButton" class="btn btn-secondary btn-md">Refresh</button>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-6 gap-3 mb-6">
      <StatCard label="Purchase orders" valueId="totalPOs" />
      <StatCard label="Ordered value" valueId="orderedValue" valueClass="text-green-400" />
      <StatCard label="Awaiting confirmation" valueId="awaitingConfirmation" valueClass="text-yellow-400" />
      <StatCard label="Ready for delivery" valueId="readyToSchedule" valueClass="text-blue-400" />
      <StatCard label="Overdue" valueId="overdueCount" valueClass="text-red-400" />
      <StatCard label="Quantity fill rate" valueId="fillRate" valueClass="text-purple-400" />
    </div>

    <div id="purchaseOrderBatches" class="space-y-4" aria-live="polite">
      <div class="card p-10 text-center text-gray-500 animate-pulse">Loading purchase-order lifecycle…</div>
    </div>
  </div>
</Layout>

<script>
  const statusClasses: Record<string, string> = {
    draft: 'badge-pending',
    sent: 'badge-info',
    confirmed: 'badge-brand',
    partially_delivered: 'badge-warning',
    delivered: 'badge-success',
    cancelled: 'badge-danger',
  };

  const lifecycleClasses: Record<string, string> = {
    awaiting_response: 'badge-pending',
    partial_response: 'badge-warning',
    expired: 'badge-danger',
    ready_for_po: 'badge-info',
    nothing_to_order: 'badge-pending',
    draft: 'badge-pending',
    sent: 'badge-info',
    awaiting_confirmation: 'badge-warning',
    ready_to_schedule: 'badge-brand',
    partially_delivered: 'badge-warning',
    delivered: 'badge-success',
    cancelled: 'badge-danger',
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function money(value: unknown): string {
    return new Intl.NumberFormat(undefined, {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    }).format(Number(value || 0));
  }

  function date(value: unknown): string {
    if (!value) return '—';
    const parsed = new Date(String(value));
    return Number.isNaN(parsed.getTime()) ? '—' : parsed.toLocaleDateString();
  }

  function label(value: unknown): string {
    const text = String(value || '');
    return text ? text.replace(/_/g, ' ') : 'Not started';
  }

  function badge(value: unknown, lifecycle = false): string {
    const key = String(value || '');
    const classes = (lifecycle ? lifecycleClasses[key] : statusClasses[key]) || 'badge-pending';
    return `<span class="badge ${classes}">${escapeHtml(label(key))}</span>`;
  }

  async function loadCompanies() {
    const resp = await fetch('/api/companies');
    if (!resp.ok) return;
    const { data } = await resp.json();
    const select = document.getElementById('companyFilter') as HTMLSelectElement;
    select.innerHTML = `<option value="">All companies</option>${(data || [])
      .map((company: any) => `<option value="${escapeHtml(company.id)}">${escapeHtml(company.name)}</option>`)
      .join('')}`;
  }

  function renderSummary(summary: any) {
    document.getElementById('totalPOs')!.textContent = String(summary?.purchase_orders || 0);
    document.getElementById('orderedValue')!.textContent = money(summary?.ordered_value);
    document.getElementById('awaitingConfirmation')!.textContent = String(summary?.awaiting_confirmation || 0);
    document.getElementById('readyToSchedule')!.textContent = String(summary?.ready_to_schedule || 0);
    document.getElementById('overdueCount')!.textContent = String(summary?.overdue || 0);
    document.getElementById('fillRate')!.textContent = `${Number(summary?.fill_rate || 0).toFixed(1)}%`;
  }

  function renderActions(row: any): string {
    if (!row.po) {
      const availabilityUrl = row.batch_id
        ? `/availability?batch_id=${encodeURIComponent(row.batch_id)}`
        : '/availability';
      return `<a href="${availabilityUrl}" class="text-sm font-medium text-emerald-400 hover:text-emerald-300">Review availability</a>`;
    }

    const actions = [];
    if (row.po.status === 'sent') {
      actions.push(`<button class="confirm-po text-sm font-medium text-green-400 hover:text-green-300" data-po-id="${escapeHtml(row.po.id)}">Confirm on behalf</button>`);
    }
    actions.push(`<a href="/deliveries?po_id=${encodeURIComponent(row.po.id)}" class="text-sm font-medium text-orange-400 hover:text-orange-300">Record delivery</a>`);
    actions.push(`<a href="/comparison?po_id=${encodeURIComponent(row.po.id)}" class="text-sm font-medium text-fuchsia-400 hover:text-fuchsia-300">Compare</a>`);
    return actions.join('<span class="text-gray-700">·</span>');
  }

  function renderCompanyRow(row: any): string {
    const po = row.po;
    const availability = row.response_stage === 'responded'
      ? `${Number(row.answered_items || 0)}/${Number(row.requested_items || 0)} answered`
      : label(row.response_stage);
    const deliveryPercent = Number(row.ordered_qty || 0) > 0
      ? Math.min(100, (Number(row.delivered_qty || 0) / Number(row.ordered_qty || 0)) * 100)
      : 0;

    return `
      <tr class="border-t border-gray-700/40 hover:bg-gray-800/40 transition-colors">
        <td class="px-4 py-3 align-top">
          <div class="font-medium text-gray-100">${escapeHtml(row.company_name || po?.company?.name || 'Unknown company')}</div>
          <div class="text-xs text-gray-500 mt-1">${escapeHtml(availability)}</div>
        </td>
        <td class="px-4 py-3 align-top">
          ${po ? `
            <div class="flex items-center gap-2">
              <button class="expand-po w-6 h-6 inline-flex items-center justify-center rounded-md bg-gray-800 hover:bg-gray-700 border border-gray-700 text-gray-300" data-po-id="${escapeHtml(po.id)}" aria-expanded="false" aria-controls="po-details-${escapeHtml(po.id)}">+</button>
              <span class="font-mono text-gray-100">${escapeHtml(po.po_number || '—')}</span>
            </div>
            <div class="mt-2">${badge(po.status)}</div>
          ` : '<span class="text-gray-500">No PO generated</span>'}
        </td>
        <td class="px-4 py-3 text-right align-top">
          <div class="text-gray-100 tabular-nums">${money(row.ordered_value)}</div>
          <div class="text-xs text-gray-500 mt-1">${Number(row.ordered_qty || 0)} units</div>
        </td>
        <td class="px-4 py-3 align-top min-w-[10rem]">
          <div class="flex justify-between text-xs text-gray-400 mb-1">
            <span>${Number(row.delivered_qty || 0)}/${Number(row.ordered_qty || 0)}</span>
            <span>${deliveryPercent.toFixed(0)}%</span>
          </div>
          <div class="h-1.5 rounded-full bg-gray-700 overflow-hidden">
            <div class="h-full bg-orange-500 rounded-full" style="width:${deliveryPercent}%"></div>
          </div>
          <div class="text-xs ${row.is_overdue ? 'text-red-400' : 'text-gray-500'} mt-1">
            ${row.is_overdue ? 'Overdue · ' : ''}${date(row.delivery_date)}
          </div>
        </td>
        <td class="px-4 py-3 align-top">
          ${badge(row.lifecycle_stage, true)}
          <div class="text-xs text-gray-400 mt-2 max-w-[14rem]">${escapeHtml(row.next_action || 'Review')}</div>
        </td>
        <td class="px-4 py-3 align-top">
          <div class="flex flex-wrap items-center gap-2">${renderActions(row)}</div>
        </td>
      </tr>
      ${po ? `
        <tr id="po-details-${escapeHtml(po.id)}" class="hidden bg-gray-900/40" data-loaded="false">
          <td colspan="6" class="px-4 py-4">
            <div id="po-details-content-${escapeHtml(po.id)}" class="text-sm text-gray-500 animate-pulse">Loading items…</div>
          </td>
        </tr>
      ` : ''}
    `;
  }

  function renderBatch(batchGroup: any, index: number): string {
    const batch = batchGroup.batch || {};
    const summary = batchGroup.summary || {};
    const rows = batchGroup.rows || [];
    const warning = Number(summary.overdue || 0) > 0
      ? `<span class="badge badge-danger">${summary.overdue} overdue</span>`
      : Number(summary.awaiting_confirmation || 0) > 0
        ? `<span class="badge badge-warning">${summary.awaiting_confirmation} awaiting confirmation</span>`
        : Number(summary.ready_to_schedule || 0) > 0
          ? `<span class="badge badge-brand">${summary.ready_to_schedule} ready for delivery</span>`
          : '';

    return `
      <section class="card overflow-hidden" data-batch-id="${escapeHtml(batch.id)}">
        <button class="batch-toggle w-full p-4 flex flex-col md:flex-row md:items-center justify-between gap-3 text-left hover:bg-gray-800/30" aria-expanded="${index < 3 ? 'true' : 'false'}" aria-controls="batch-content-${escapeHtml(batch.id)}">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-base font-semibold text-gray-100">${escapeHtml(batch.name || 'Unknown batch')}</h2>
              ${warning}
            </div>
            <p class="text-xs text-gray-500 mt-1">
              ${summary.companies || 0} companies · ${summary.purchase_orders || 0} POs · ${date(batchGroup.last_activity_at)} last activity
            </p>
          </div>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-gray-400">${money(summary.delivered_value)} / ${money(summary.ordered_value)} delivered</span>
            <span class="batch-icon text-gray-400 text-lg">${index < 3 ? '−' : '+'}</span>
          </div>
        </button>
        <div id="batch-content-${escapeHtml(batch.id)}" class="${index < 3 ? '' : 'hidden'} border-t border-gray-700/60">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr>
                  <th class="table-header-cell text-left">Company / availability</th>
                  <th class="table-header-cell text-left">Purchase order</th>
                  <th class="table-header-cell text-right">Ordered</th>
                  <th class="table-header-cell text-left">Delivery</th>
                  <th class="table-header-cell text-left">Decision</th>
                  <th class="table-header-cell text-left">Actions</th>
                </tr>
              </thead>
              <tbody>${rows.map(renderCompanyRow).join('')}</tbody>
            </table>
          </div>
        </div>
      </section>
    `;
  }

  function wireRenderedActions() {
    document.querySelectorAll('.batch-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const target = document.getElementById(button.getAttribute('aria-controls') || '');
        if (!target) return;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        target.classList.toggle('hidden', expanded);
        const icon = button.querySelector('.batch-icon');
        if (icon) icon.textContent = expanded ? '+' : '−';
      });
    });

    document.querySelectorAll('.expand-po').forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.stopPropagation();
        const poId = (button as HTMLElement).dataset.poId;
        if (!poId) return;
        const row = document.getElementById(`po-details-${poId}`);
        if (!row) return;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        button.textContent = expanded ? '+' : '−';
        row.classList.toggle('hidden', expanded);
        if (!expanded && row.dataset.loaded !== 'true') {
          await loadPOItems(poId);
          row.dataset.loaded = 'true';
        }
      });
    });

    document.querySelectorAll('.confirm-po').forEach((button) => {
      button.addEventListener('click', async () => {
        const poId = (button as HTMLElement).dataset.poId;
        if (!poId || !confirm('Confirm this purchase order on behalf of the company?')) return;
        const resp = await fetch('/api/purchase-orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'confirm', id: poId }),
        });
        if (resp.ok) await loadLifecycle();
        else alert('Failed to confirm the purchase order.');
      });
    });
  }

  async function loadPOItems(poId: string) {
    const target = document.getElementById(`po-details-content-${poId}`);
    if (!target) return;
    try {
      const resp = await fetch(`/api/purchase-orders?id=${encodeURIComponent(poId)}&items=true`);
      if (!resp.ok) throw new Error('Request failed');
      const { data } = await resp.json();
      const items = Array.isArray(data) ? data : [];
      target.classList.remove('animate-pulse');
      target.innerHTML = items.length === 0
        ? '<div class="text-gray-500">No items in this purchase order.</div>'
        : `
          <div class="overflow-x-auto rounded-lg border border-gray-700/40">
            <table class="w-full text-xs">
              <thead>
                <tr>
                  <th class="table-header-cell text-left">Product</th>
                  <th class="table-header-cell text-right">Qty</th>
                  <th class="table-header-cell text-right">Boxes</th>
                  <th class="table-header-cell text-right">Price/box</th>
                  <th class="table-header-cell text-right">Total</th>
                  <th class="table-header-cell text-center">Delivered</th>
                  <th class="table-header-cell text-left">Notes</th>
                </tr>
              </thead>
              <tbody>
                ${items.map((item: any) => `
                  <tr class="border-t border-gray-700/40">
                    <td class="px-3 py-2 text-gray-100">${escapeHtml(item.product?.title || item.product?.barcode || '—')}</td>
                    <td class="px-3 py-2 text-right text-gray-200 tabular-nums">${Number(item.quantity || 0)}</td>
                    <td class="px-3 py-2 text-right text-gray-200 tabular-nums">${Number(item.boxes || 0).toFixed(2)}</td>
                    <td class="px-3 py-2 text-right text-gray-200 tabular-nums">${money(item.price_per_box)}</td>
                    <td class="px-3 py-2 text-right text-gray-200 tabular-nums">${money(item.total_price)}</td>
                    <td class="px-3 py-2 text-center text-gray-300 tabular-nums">${Number(item.delivered_qty || 0)}/${Number(item.quantity || 0)}</td>
                    <td class="px-3 py-2 text-gray-300">${escapeHtml(item.delivery_notes || '—')}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        `;
    } catch {
      target.classList.remove('animate-pulse');
      target.textContent = 'Failed to load items.';
    }
  }

  async function loadLifecycle() {
    const container = document.getElementById('purchaseOrderBatches')!;
    container.innerHTML = '<div class="card p-10 text-center text-gray-500 animate-pulse">Loading purchase-order lifecycle…</div>';

    const params = new URLSearchParams({ view: 'lifecycle' });
    const company = (document.getElementById('companyFilter') as HTMLSelectElement)?.value;
    const status = (document.getElementById('statusFilter') as HTMLSelectElement)?.value;
    if (company) params.set('company_id', company);
    if (status) params.set('status', status);

    try {
      const resp = await fetch(`/api/purchase-orders?${params}`);
      const json = await resp.json();
      if (!resp.ok) throw new Error(json.error || 'Request failed');
      renderSummary(json.summary);
      const batches = Array.isArray(json.batches) ? json.batches : [];
      container.innerHTML = batches.length
        ? batches.map(renderBatch).join('')
        : '<div class="card p-10 text-center text-gray-400">No company lifecycle rows match these filters.</div>';
      wireRenderedActions();
    } catch (error) {
      container.innerHTML = `<div class="card p-10 text-center text-red-400">${escapeHtml(error instanceof Error ? error.message : 'Failed to load purchase orders.')}</div>`;
    }
  }

  document.getElementById('companyFilter')?.addEventListener('change', loadLifecycle);
  document.getElementById('statusFilter')?.addEventListener('change', loadLifecycle);
  document.getElementById('refreshButton')?.addEventListener('click', loadLifecycle);

  loadCompanies();
  loadLifecycle();
</script>
