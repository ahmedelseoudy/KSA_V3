---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import StatCard from '../components/ui/StatCard.astro';

const user = Astro.locals.user;
const profile = (user as any)?.profile;

if (!profile || !['admin', 'super_admin'].includes(profile.role)) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Availability Overview - KSA CRM">
  <div class="max-w-7xl mx-auto">
    <PageHeader title="Availability Overview" subtitle="Track each batch, collect supplier responses, and generate purchase orders" />

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <StatCard label="Total Requests" valueId="totalRequests" />
      <StatCard label="Fully Responded" valueId="fullResponded" valueClass="text-green-400" />
      <StatCard label="Pending" valueId="pending" valueClass="text-yellow-400" />
      <StatCard label="Unavailable Responses" valueId="unavailableCount" valueClass="text-red-400" />
    </div>

    <div class="card p-4 mb-5 sticky top-0 z-20 backdrop-blur">
      <div class="flex flex-wrap items-end gap-3">
        <div>
          <label for="availCompanyFilter" class="block text-xs text-gray-500 mb-1">Company</label>
          <select id="availCompanyFilter" class="input min-w-[13rem]">
            <option value="all">All companies</option>
          </select>
        </div>
        <div>
          <label for="availStatusFilter" class="block text-xs text-gray-500 mb-1">Response status</label>
          <select id="availStatusFilter" class="input">
            <option value="all">All statuses</option>
            <option value="pending">Pending</option>
            <option value="partially_responded">Partially responded</option>
            <option value="responded">Responded</option>
            <option value="expired">Expired</option>
          </select>
        </div>
        <div id="deepLinkNotice" class="hidden ml-auto items-center gap-2 rounded-lg border border-purple-500/30 bg-purple-500/10 px-3 py-2 text-sm text-purple-300">
          <span id="deepLinkText"></span>
          <button id="showAllBatches" class="font-semibold hover:text-purple-200">Show all</button>
        </div>
      </div>
    </div>

    <div id="batchSections" class="space-y-4">
      <div class="card py-12 text-center text-gray-500 text-sm animate-pulse">Loading availability batches…</div>
    </div>
  </div>
</Layout>

<script>
  import * as XLSX from 'xlsx';

  type SectionState = {
    expanded: boolean;
    loaded: boolean;
    sortKey: string;
    sortDir: 'asc' | 'desc';
    page: number;
    pageSize: number;
    includePartial: boolean;
  };

  let allAvailOrders: any[] = [];
  let availCompanyFilter = 'all';
  let availStatusFilter = 'all';
  let forcedBatchId = new URLSearchParams(window.location.search).get('batch_id') || '';
  const sections = new Map<string, SectionState>();
  const unavailableByBatch = new Map<string, any[]>();
  const generationResults = new Map<string, any>();
  (window as any).__AV_STATE__ = { sections };

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatDate(value: string | null | undefined): string {
    if (!value) return '—';
    return new Date(value).toLocaleDateString(undefined, {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function getSectionState(batchId: string): SectionState {
    let state = sections.get(batchId);
    if (!state) {
      state = {
        expanded: forcedBatchId === batchId,
        loaded: false,
        sortKey: 'status',
        sortDir: 'asc',
        page: 1,
        pageSize: 50,
        includePartial: false,
      };
      sections.set(batchId, state);
    }
    return state;
  }

  function groupedBatches(): Array<{ id: string; batch: any; orders: any[] }> {
    const grouped = new Map<string, { id: string; batch: any; orders: any[] }>();
    for (const order of allAvailOrders) {
      if (forcedBatchId && order.batch_id !== forcedBatchId) continue;
      if (!grouped.has(order.batch_id)) {
        grouped.set(order.batch_id, {
          id: order.batch_id,
          batch: order.batch || {
            id: order.batch_id,
            name: `Batch ${order.batch_id.slice(0, 8)}`,
            status: 'unknown',
            created_at: order.created_at,
          },
          orders: [],
        });
      }
      grouped.get(order.batch_id)!.orders.push(order);
    }
    return Array.from(grouped.values()).sort(
      (a, b) => new Date(b.batch?.created_at || 0).getTime() - new Date(a.batch?.created_at || 0).getTime()
    );
  }

  function filteredOrders(orders: any[]): any[] {
    return orders.filter((order) => {
      const companyMatch = availCompanyFilter === 'all' || order.company?.id === availCompanyFilter;
      const statusMatch = availStatusFilter === 'all' || order.status === availStatusFilter;
      return companyMatch && statusMatch;
    });
  }

  function batchMetrics(orders: any[]) {
    const responded = orders.filter((order) => order.status === 'responded').length;
    const partial = orders.filter((order) => order.status === 'partially_responded').length;
    const pending = orders.filter((order) => order.status === 'pending').length;
    const expired = orders.filter((order) => order.status === 'expired').length;
    const available = orders.reduce((sum, order) => sum + Number(order.available_count || 0), 0);
    const unavailable = orders.reduce((sum, order) => sum + Number(order.unavailable_count || 0), 0);
    const activePOs = orders.filter((order) => (order.purchase_orders || []).length > 0).length;
    const eligible = orders.filter((order) =>
      ['responded', 'partially_responded'].includes(order.status) &&
      Number(order.available_count || 0) > 0
    ).length;
    return {
      total: orders.length,
      responded,
      partial,
      pending,
      expired,
      available,
      unavailable,
      activePOs,
      eligible,
    };
  }

  function derivedBatchState(batch: any, metrics: ReturnType<typeof batchMetrics>) {
    if (batch?.status === 'cancelled') {
      return { label: 'CANCELLED', classes: 'badge badge-danger' };
    }
    if (metrics.responded + metrics.partial === 0) {
      return { label: 'OPEN — COLLECTING', classes: 'badge badge-pending' };
    }
    if (metrics.activePOs > 0 && metrics.activePOs < metrics.eligible) {
      return { label: 'CLOSING — POs PARTIALLY SENT', classes: 'badge badge-warning' };
    }
    if (metrics.eligible > 0 && metrics.activePOs >= metrics.eligible) {
      return { label: 'CLOSED — POs SENT', classes: 'badge badge-success' };
    }
    if (metrics.available === 0 && metrics.pending === 0 && metrics.partial === 0) {
      return { label: 'OPEN — NOTHING TO ORDER', classes: 'badge badge-danger' };
    }
    if (metrics.eligible > 0) {
      return { label: 'OPEN — READY FOR POs', classes: 'badge badge-info' };
    }
    return { label: 'OPEN — COLLECTING', classes: 'badge badge-pending' };
  }

  function renderSections() {
    const container = document.getElementById('batchSections');
    if (!container) return;
    const batches = groupedBatches();

    if (batches.length === 0) {
      container.innerHTML = '<div class="card py-12 text-center text-gray-400 text-sm">No availability batches found.</div>';
      return;
    }

    container.innerHTML = batches.map(({ id, batch, orders }) => {
      const state = getSectionState(id);
      const metrics = batchMetrics(orders);
      const lifecycle = derivedBatchState(batch, metrics);
      const responsePct = metrics.total > 0
        ? Math.round(((metrics.responded + metrics.partial) / metrics.total) * 100)
        : 0;

      return `
        <section class="card overflow-hidden" data-batch-section="${id}">
          <button type="button" class="batch-toggle w-full p-5 text-left hover:bg-gray-800/30 transition-colors" data-batch-id="${id}" aria-expanded="${state.expanded}">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="flex min-w-0 items-start gap-3">
                <span class="batch-chevron mt-1 text-gray-400" aria-hidden="true">${state.expanded ? '▾' : '▸'}</span>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <h2 class="text-lg font-semibold text-white truncate">${escapeHtml(batch?.name || id)}</h2>
                    <span class="${lifecycle.classes}">${lifecycle.label}</span>
                    <span class="badge badge-brand">${escapeHtml(String(batch?.status || 'unknown').replace(/_/g, ' '))}</span>
                  </div>
                  <p class="mt-1 text-sm text-gray-400">Created ${formatDate(batch?.created_at)} · ${metrics.total} companies</p>
                </div>
              </div>
              <div class="text-right text-sm text-gray-300 tabular-nums">
                <div class="font-semibold">${metrics.responded + metrics.partial} / ${metrics.total} companies answered</div>
                <div class="mt-1 text-xs text-gray-500">${metrics.available} available · ${metrics.unavailable} unavailable</div>
              </div>
            </div>
            <div class="mt-4 grid gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
              <div class="h-2 overflow-hidden rounded-full bg-gray-700">
                <div class="h-full rounded-full bg-emerald-500 transition-all" style="width:${responsePct}%"></div>
              </div>
              <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-400">
                <span class="text-green-400">✔ ${metrics.responded} responded</span>
                <span class="text-yellow-400">◐ ${metrics.partial} partial</span>
                <span>○ ${metrics.pending} pending</span>
                ${metrics.expired ? `<span class="text-red-400">⌛ ${metrics.expired} expired</span>` : ''}
              </div>
            </div>
          </button>
          <div class="batch-body ${state.expanded ? '' : 'hidden'} border-t border-gray-700/60" data-batch-body="${id}">
            ${state.loaded ? '' : '<div class="py-10 text-center text-gray-500 text-sm animate-pulse">Loading batch details…</div>'}
          </div>
        </section>
      `;
    }).join('');

    container.querySelectorAll<HTMLButtonElement>('.batch-toggle').forEach((button) => {
      button.addEventListener('click', async () => {
        const batchId = button.dataset.batchId!;
        const state = getSectionState(batchId);
        state.expanded = !state.expanded;
        button.setAttribute('aria-expanded', String(state.expanded));
        button.querySelector('.batch-chevron')!.textContent = state.expanded ? '▾' : '▸';
        const body = container.querySelector<HTMLElement>(`[data-batch-body="${batchId}"]`)!;
        body.classList.toggle('hidden', !state.expanded);
        if (state.expanded && !state.loaded) {
          state.loaded = true;
          await renderSectionBody(batchId);
        }
      });
    });

    for (const { id } of batches) {
      const state = getSectionState(id);
      if (state.expanded) {
        state.loaded = true;
        void renderSectionBody(id);
      }
    }
  }

  function statusRank(status: string): number {
    return ({ pending: 0, partially_responded: 1, responded: 2, expired: 3 } as Record<string, number>)[status] ?? 4;
  }

  function sortValue(order: any, key: string): string | number {
    switch (key) {
      case 'company': return String(order.company?.name || '').toLowerCase();
      case 'total_items': return Number(order.total_items || 0);
      case 'available_count': return Number(order.available_count || 0);
      case 'unavailable_count': return Number(order.unavailable_count || 0);
      case 'rate': return Number(order.total_items || 0) > 0
        ? Number(order.available_count || 0) / Number(order.total_items)
        : 0;
      case 'status': return statusRank(order.status);
      default: return '';
    }
  }

  function statusBadge(order: any): string {
    const classes = order.status === 'responded'
      ? 'badge badge-success'
      : order.status === 'partially_responded'
        ? 'badge badge-warning'
        : order.status === 'expired'
          ? 'badge badge-danger'
          : 'badge badge-pending';
    return `<span class="${classes}">${escapeHtml(String(order.status || 'pending').replace(/_/g, ' '))}</span>`;
  }

  function renderGenerationResult(batchId: string): string {
    const payload = generationResults.get(batchId);
    if (!payload) return '';
    const results = Array.isArray(payload.results) ? payload.results : [];
    const orders = allAvailOrders.filter((order) => order.batch_id === batchId);
    const companyNames = new Map(orders.map((order) => [order.company_id, order.company?.name || 'Unknown company']));
    const title = payload.created > 0
      ? `${payload.created} purchase order${payload.created === 1 ? '' : 's'} created`
      : 'No purchase orders were created';
    return `
      <div class="mt-3 rounded-xl border ${payload.created > 0 ? 'border-green-500/30 bg-green-500/10' : 'border-yellow-500/30 bg-yellow-500/10'} p-3">
        <div class="font-semibold ${payload.created > 0 ? 'text-green-300' : 'text-yellow-300'}">${title}</div>
        <div class="mt-1 text-xs text-gray-400">${payload.emails_sent || 0} email${payload.emails_sent === 1 ? '' : 's'} delivered · ${(payload.emails_failed || []).length} failed</div>
        <details class="mt-2">
          <summary class="cursor-pointer text-xs font-medium text-gray-300">Company-by-company results</summary>
          <ul class="mt-2 space-y-1 text-xs text-gray-400">
            ${results.map((result: any) => `
              <li><span class="text-gray-200">${escapeHtml(companyNames.get(result.company_id) || 'Unknown company')}</span> — ${escapeHtml(result.outcome === 'created' ? 'created' : formatReason(result.reason))}</li>
            `).join('')}
          </ul>
        </details>
      </div>
    `;
  }

  function formatReason(reason: string | undefined): string {
    const labels: Record<string, string> = {
      not_responded: 'not responded',
      all_items_unavailable: 'all items unavailable',
      no_available_items: 'no available items',
      already_generated: 'already generated',
      no_resolvable_items: 'no resolvable items',
      insert_failed: 'PO insert failed',
      items_insert_failed: 'PO item insert failed',
      responses_query_failed: 'response lookup failed',
    };
    return labels[reason || ''] || String(reason || 'skipped').replace(/_/g, ' ');
  }

  async function renderSectionBody(batchId: string) {
    const body = document.querySelector<HTMLElement>(`[data-batch-body="${batchId}"]`);
    if (!body) return;
    const state = getSectionState(batchId);
    const batchOrders = allAvailOrders.filter((order) => order.batch_id === batchId);
    const metrics = batchMetrics(batchOrders);
    const rows = filteredOrders(batchOrders);
    const sorted = [...rows].sort((a, b) => {
      const av = sortValue(a, state.sortKey);
      const bv = sortValue(b, state.sortKey);
      if (av < bv) return state.sortDir === 'asc' ? -1 : 1;
      if (av > bv) return state.sortDir === 'asc' ? 1 : -1;
      return String(a.company?.name || '').localeCompare(String(b.company?.name || ''));
    });
    const pageCount = Math.max(1, Math.ceil(sorted.length / state.pageSize));
    state.page = Math.min(state.page, pageCount);
    const start = (state.page - 1) * state.pageSize;
    const pageRows = sorted.slice(start, start + state.pageSize);

    body.innerHTML = `
      <div class="p-4 border-b border-gray-700/60 bg-gray-900/30">
        <div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_auto] xl:items-end">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Generate purchase orders for this batch</p>
            <div class="mt-2 flex flex-wrap items-end gap-3">
              <div>
                <label class="block text-xs text-gray-500 mb-1" for="po-number-${batchId}">PO reference</label>
                <input id="po-number-${batchId}" class="input min-w-[14rem]" placeholder="Use batch name" />
              </div>
              <div>
                <label class="block text-xs text-gray-500 mb-1" for="po-date-${batchId}">Delivery date</label>
                <input id="po-date-${batchId}" type="date" class="input min-w-[11rem]" />
              </div>
              <button id="generate-pos-${batchId}" class="btn btn-primary btn-md" disabled>Checking eligibility…</button>
            </div>
            <p id="po-preview-${batchId}" class="mt-2 text-sm text-gray-400">Checking which companies are ready…</p>
            <div id="po-result-${batchId}">${renderGenerationResult(batchId)}</div>
          </div>
          ${metrics.partial > 0 ? `
            <fieldset class="rounded-xl border border-gray-700/60 bg-gray-800/40 p-3 text-sm">
              <legend class="px-1 text-xs font-semibold uppercase tracking-wider text-gray-500">Which companies?</legend>
              <label class="flex cursor-pointer items-start gap-2 text-gray-200">
                <input type="radio" name="partial-${batchId}" value="false" class="mt-1 accent-purple-600" ${state.includePartial ? '' : 'checked'} />
                <span>Only companies that finished their whole list</span>
              </label>
              <label class="mt-2 flex cursor-pointer items-start gap-2 text-gray-200">
                <input type="radio" name="partial-${batchId}" value="true" class="mt-1 accent-purple-600" ${state.includePartial ? 'checked' : ''} />
                <span>Also companies that answered only part of their list <span class="text-yellow-400">(+${metrics.partial})</span><span class="block text-xs text-gray-500">Their PO covers only items confirmed available.</span></span>
              </label>
            </fieldset>
          ` : ''}
        </div>
      </div>

      <div class="max-h-[42rem] overflow-auto">
        <table class="w-full text-sm">
          <thead class="sticky top-0 z-10">
            <tr>
              <th class="px-3 py-3 text-left bg-gray-800/95 w-8"></th>
              ${tableHeader(batchId, 'company', 'Company', 'left')}
              ${tableHeader(batchId, 'total_items', 'Total items', 'right')}
              ${tableHeader(batchId, 'available_count', 'Available', 'right')}
              ${tableHeader(batchId, 'unavailable_count', 'Unavailable', 'right')}
              ${tableHeader(batchId, 'rate', 'Rate', 'right')}
              ${tableHeader(batchId, 'status', 'Status', 'center')}
            </tr>
          </thead>
          <tbody>
            ${pageRows.length === 0
              ? '<tr><td colspan="7" class="py-12 text-center text-gray-400">No companies match these filters.</td></tr>'
              : pageRows.map(renderCompanyRow).join('')}
          </tbody>
        </table>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-gray-700/60 bg-gray-800/30 p-3">
        <label class="flex items-center gap-2 text-sm text-gray-400">Rows
          <select id="page-size-${batchId}" class="input py-1.5">
            ${[20, 50, 100].map((size) => `<option value="${size}" ${state.pageSize === size ? 'selected' : ''}>${size}</option>`).join('')}
          </select>
        </label>
        <div class="flex items-center gap-2">
          <button id="prev-${batchId}" class="btn btn-secondary btn-sm" ${state.page <= 1 ? 'disabled' : ''}>Prev</button>
          <span class="text-sm text-gray-400">Page ${state.page} of ${pageCount}</span>
          <button id="next-${batchId}" class="btn btn-secondary btn-sm" ${state.page >= pageCount ? 'disabled' : ''}>Next</button>
        </div>
      </div>

      <div class="border-t border-gray-700/60">
        <div class="flex flex-wrap items-center justify-between gap-3 p-4">
          <div>
            <h3 class="font-semibold text-white">Unavailable items in this batch</h3>
            <p class="text-xs text-gray-500">Compared across the companies currently included by the filters.</p>
          </div>
          <button id="download-unavailable-${batchId}" class="btn btn-soft-danger btn-sm" disabled>Download unavailable</button>
        </div>
        <div id="unavailable-${batchId}" class="px-4 pb-4 text-sm text-gray-500 animate-pulse">Loading unavailable items…</div>
      </div>
    `;

    wireSectionBody(batchId);
    await Promise.all([
      refreshPOPreview(batchId),
      loadUnavailableItems(batchId, rows),
    ]);
  }

  function tableHeader(batchId: string, key: string, label: string, align: string): string {
    const state = getSectionState(batchId);
    const marker = state.sortKey === key ? (state.sortDir === 'asc' ? '▲' : '▼') : '';
    const alignClass = align === 'right' ? 'text-right' : align === 'center' ? 'text-center' : 'text-left';
    return `<th data-sort-key="${key}" class="batch-sort px-4 py-3 ${alignClass} text-xs font-semibold uppercase tracking-wider text-gray-400 bg-gray-800/95 cursor-pointer select-none">${label} <span class="text-gray-500">${marker}</span></th>`;
  }

  function renderCompanyRow(order: any): string {
    const rate = Number(order.total_items || 0) > 0
      ? Math.round((Number(order.available_count || 0) / Number(order.total_items)) * 100)
      : 0;
    return `
      <tr class="border-t border-gray-700/40 hover:bg-gray-800/40 transition-colors" data-row="${order.id}">
        <td class="px-3 py-3 align-top">
          <button class="expand-btn inline-flex h-6 w-6 items-center justify-center rounded-md border border-gray-700 bg-gray-800 text-xs text-gray-300 hover:bg-gray-700 hover:text-white" aria-expanded="false" aria-controls="details-${order.id}" data-id="${order.id}">+</button>
        </td>
        <td class="px-4 py-3 font-medium text-white">${escapeHtml(order.company?.name || 'Unknown')}</td>
        <td class="px-4 py-3 text-right text-white tabular-nums">${Number(order.total_items || 0)}</td>
        <td class="px-4 py-3 text-right text-green-400 tabular-nums">${Number(order.available_count || 0)}</td>
        <td class="px-4 py-3 text-right text-red-400 tabular-nums">${Number(order.unavailable_count || 0)}</td>
        <td class="px-4 py-3 text-right text-white tabular-nums">${rate}%</td>
        <td class="px-4 py-3 text-center">${statusBadge(order)}</td>
      </tr>
      <tr id="details-${order.id}" class="hidden border-t border-gray-700/40 bg-gray-900/40" data-loaded="false">
        <td></td>
        <td class="px-4 py-4" colspan="6">
          <div id="details-content-${order.id}" class="text-sm text-gray-400"><span class="animate-pulse text-gray-500">Loading details…</span></div>
        </td>
      </tr>
    `;
  }

  function wireSectionBody(batchId: string) {
    const body = document.querySelector<HTMLElement>(`[data-batch-body="${batchId}"]`)!;
    const state = getSectionState(batchId);

    body.querySelectorAll<HTMLElement>('.batch-sort').forEach((header) => {
      header.addEventListener('click', () => {
        const key = header.dataset.sortKey || 'status';
        if (state.sortKey === key) state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
        else {
          state.sortKey = key;
          state.sortDir = 'asc';
        }
        state.page = 1;
        void renderSectionBody(batchId);
      });
    });

    body.querySelector(`#prev-${batchId}`)?.addEventListener('click', () => {
      state.page = Math.max(1, state.page - 1);
      void renderSectionBody(batchId);
    });
    body.querySelector(`#next-${batchId}`)?.addEventListener('click', () => {
      state.page += 1;
      void renderSectionBody(batchId);
    });
    body.querySelector<HTMLSelectElement>(`#page-size-${batchId}`)?.addEventListener('change', (event) => {
      state.pageSize = Number((event.target as HTMLSelectElement).value) || 50;
      state.page = 1;
      void renderSectionBody(batchId);
    });

    body.querySelectorAll<HTMLInputElement>(`input[name="partial-${batchId}"]`).forEach((radio) => {
      radio.addEventListener('change', () => {
        state.includePartial = radio.value === 'true';
        void refreshPOPreview(batchId);
      });
    });

    body.querySelector<HTMLButtonElement>(`#generate-pos-${batchId}`)?.addEventListener('click', () => {
      void generatePurchaseOrders(batchId);
    });

    body.querySelector<HTMLButtonElement>(`#download-unavailable-${batchId}`)?.addEventListener('click', () => {
      downloadUnavailable(batchId);
    });

    body.querySelectorAll<HTMLButtonElement>('.expand-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.dataset.id!;
        const row = document.getElementById(`details-${id}`)!;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        button.textContent = expanded ? '+' : '−';
        row.classList.toggle('hidden', expanded);
        if (!expanded && row.dataset.loaded !== 'true') {
          await loadCompanyDetails(id);
          row.dataset.loaded = 'true';
        }
      });
    });
  }

  async function refreshPOPreview(batchId: string) {
    const state = getSectionState(batchId);
    const button = document.getElementById(`generate-pos-${batchId}`) as HTMLButtonElement | null;
    const preview = document.getElementById(`po-preview-${batchId}`);
    if (!button || !preview) return;

    button.disabled = true;
    button.textContent = 'Checking eligibility…';
    preview.textContent = 'Checking which companies are ready…';

    try {
      const response = await fetch('/api/purchase-orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'generate',
          batch_id: batchId,
          include_partial: state.includePartial,
          dry_run: true,
        }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || 'Eligibility check failed');
      const results = Array.isArray(payload.results) ? payload.results : [];
      const ready = results.filter((result: any) => result.outcome === 'would_create').length;
      const notResponded = results.filter((result: any) => result.reason === 'not_responded').length;

      if (ready > 0) {
        button.disabled = false;
        button.textContent = `Generate ${ready} PO${ready === 1 ? '' : 's'}`;
        preview.textContent = `${ready} compan${ready === 1 ? 'y is' : 'ies are'} ready. ${notResponded ? `${notResponded} still waiting for responses.` : ''}`;
      } else {
        button.disabled = true;
        button.textContent = 'Nothing ready';
        preview.textContent = notResponded === results.length
          ? 'No companies have responded yet — there is nothing to turn into a purchase order. Use “Enter responses on behalf” in a company row if needed.'
          : 'No new purchase orders are eligible. Expand the result details after generation attempts to see why.';
      }
    } catch (error: any) {
      button.disabled = true;
      button.textContent = 'Eligibility unavailable';
      preview.textContent = error?.message || 'Could not check PO eligibility.';
    }
  }

  async function generatePurchaseOrders(batchId: string) {
    const state = getSectionState(batchId);
    const button = document.getElementById(`generate-pos-${batchId}`) as HTMLButtonElement | null;
    const poNumber = (document.getElementById(`po-number-${batchId}`) as HTMLInputElement | null)?.value.trim() || '';
    const deliveryDate = (document.getElementById(`po-date-${batchId}`) as HTMLInputElement | null)?.value || '';
    if (!button || button.disabled) return;

    button.disabled = true;
    button.textContent = 'Generating…';
    try {
      const response = await fetch('/api/purchase-orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'generate',
          batch_id: batchId,
          po_number: poNumber || undefined,
          delivery_date: deliveryDate || undefined,
          include_partial: state.includePartial,
        }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || 'Failed to generate purchase orders');
      generationResults.set(batchId, payload);
      await loadAvailabilityData();
    } catch (error: any) {
      generationResults.set(batchId, {
        created: 0,
        results: [{ company_id: '', outcome: 'failed', reason: error?.message || 'generation failed' }],
        emails_sent: 0,
        emails_failed: [],
      });
      const result = document.getElementById(`po-result-${batchId}`);
      if (result) result.innerHTML = renderGenerationResult(batchId);
      await refreshPOPreview(batchId);
    }
  }

  async function loadCompanyDetails(availabilityOrderId: string) {
    const target = document.getElementById(`details-content-${availabilityOrderId}`);
    if (!target) return;
    try {
      const response = await fetch(`/api/availability?id=${availabilityOrderId}`);
      if (!response.ok) {
        target.textContent = 'Failed to load details.';
        return;
      }
      const { data } = await response.json();
      const items = Array.isArray(data) ? data : [];
      const available = items.filter((item: any) => item.is_available === true);
      const unavailable = items.filter((item: any) => item.is_available === false);
      const unanswered = items.filter((item: any) => item.is_available === null);

      const responded = items.filter((item: any) => item.is_available !== null);
      const roles = new Set(responded.map((item: any) => item.responded_by_role).filter(Boolean));
      const adminOnly = roles.size > 0 && Array.from(roles).every((role) => role === 'admin' || role === 'super_admin');
      const adminEmails = Array.from(new Set(responded.map((item: any) => item.responded_by_profile?.email).filter(Boolean)));
      const attributionBadge = roles.size === 1 && roles.has('company')
        ? '<span class="badge badge-success">Responded by company</span>'
        : adminOnly
          ? `<span class="badge badge-info">Entered by admin${adminEmails.length ? ` (${escapeHtml(adminEmails.join(', '))})` : ''}</span>`
          : roles.size > 1
            ? '<span class="badge badge-warning">Mixed: company + admin</span>'
            : responded.length > 0
              ? '<span class="badge badge-pending">Attribution unknown</span>'
              : '';

      const byLabel = (item: any) => {
        if (!item.responded_by_role) return '—';
        if (item.responded_by_role === 'company') return 'Company';
        return `Admin${item.responded_by_profile?.email ? ` (${escapeHtml(item.responded_by_profile.email)})` : ''}`;
      };

      const renderReadOnlyRow = (item: any) => {
        const orderItem = item.order_item || {};
        return `
          <tr class="border-t border-gray-700/40">
            <td class="px-3 py-2 font-mono text-xs text-gray-200">${escapeHtml(orderItem.barcode || '—')}</td>
            <td class="px-3 py-2 text-gray-100">${escapeHtml(orderItem.title || '—')}</td>
            <td class="px-3 py-2 text-gray-300">${escapeHtml(orderItem.asin || '—')}</td>
            <td class="px-3 py-2 text-right text-gray-200">${Number(orderItem.order_qty || 0)}</td>
            <td class="px-3 py-2 text-right text-gray-200">${Number(orderItem.boxes || 0)}</td>
            <td class="px-3 py-2 text-right text-gray-200">${Number(orderItem.provider_cost || 0).toFixed(2)}</td>
            <td class="px-3 py-2 text-gray-300">${escapeHtml(item.comment || '—')}</td>
            <td class="px-3 py-2 text-xs text-gray-400">${byLabel(item)}</td>
          </tr>
        `;
      };

      const readOnlySection = (title: string, rows: any[]) => `
        <div class="mb-4">
          <h3 class="mb-2 font-semibold text-white">${title} <span class="text-xs font-normal text-gray-400">(${rows.length})</span></h3>
          ${rows.length === 0 ? '<p class="text-sm text-gray-500">No items.</p>' : `
            <div class="overflow-x-auto rounded-lg border border-gray-700/40">
              <table class="w-full text-xs">
                <thead><tr>
                  ${['Barcode', 'Title', 'ASIN', 'Order qty', 'Boxes', 'Provider cost', 'Comment', 'By'].map((label, index) =>
                    `<th class="px-3 py-2 ${index >= 3 && index <= 5 ? 'text-right' : 'text-left'} text-xs font-semibold uppercase tracking-wider text-gray-400 bg-gray-800/80">${label}</th>`
                  ).join('')}
                </tr></thead>
                <tbody>${rows.map(renderReadOnlyRow).join('')}</tbody>
              </table>
            </div>
          `}
        </div>
      `;

      const renderEditableRow = (item: any) => {
        const orderItem = item.order_item || {};
        const original = item.is_available === null ? '' : String(item.is_available);
        const originalComment = escapeHtml(item.comment || '');
        return `
          <tr class="border-t border-gray-700/40">
            <td class="px-3 py-2 font-mono text-xs text-gray-200">${escapeHtml(orderItem.barcode || '—')}</td>
            <td class="px-3 py-2 text-gray-100">${escapeHtml(orderItem.title || '—')}</td>
            <td class="px-3 py-2 text-right text-gray-200">${Number(orderItem.order_qty || 0)}</td>
            <td class="px-3 py-2 text-right text-gray-200">${Number(orderItem.boxes || 0)}</td>
            <td class="px-3 py-2 text-center">
              <select class="adm-avail-select input" data-id="${item.id}" data-orig="${original}">
                <option value="" ${original === '' ? 'selected' : ''}>—</option>
                <option value="true" ${original === 'true' ? 'selected' : ''}>Yes</option>
                <option value="false" ${original === 'false' ? 'selected' : ''}>No</option>
              </select>
            </td>
            <td class="px-3 py-2"><input class="adm-comment input w-full" data-id="${item.id}" data-orig-comment="${originalComment}" value="${originalComment}" placeholder="Optional comment" /></td>
          </tr>
        `;
      };

      target.innerHTML = `
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-700/60 bg-gray-800/60 p-3">
          <div>${attributionBadge}</div>
          <button id="edit-response-${availabilityOrderId}" class="btn btn-secondary btn-sm">Enter responses on behalf</button>
        </div>
        <div id="editor-${availabilityOrderId}" class="hidden mb-4">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <div class="flex gap-2">
              <button class="adm-mark-all btn btn-soft-success btn-sm" data-avail="true">Mark all available</button>
              <button class="adm-mark-all btn btn-soft-danger btn-sm" data-avail="false">Mark all unavailable</button>
            </div>
            <div class="flex gap-2">
              <button id="cancel-response-${availabilityOrderId}" class="btn btn-secondary btn-sm">Cancel</button>
              <button id="save-response-${availabilityOrderId}" class="btn btn-primary btn-sm">Save responses</button>
            </div>
          </div>
          <div class="overflow-x-auto rounded-xl border border-gray-700/60">
            <table class="w-full text-sm">
              <thead><tr>
                ${['Barcode', 'Title', 'Qty', 'Boxes', 'Available', 'Comment'].map((label) => `<th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-gray-400 bg-gray-800/80">${label}</th>`).join('')}
              </tr></thead>
              <tbody>${items.map(renderEditableRow).join('')}</tbody>
            </table>
          </div>
        </div>
        <div id="readonly-${availabilityOrderId}">
          ${readOnlySection('Available items', available)}
          ${readOnlySection('Unavailable items', unavailable)}
          ${readOnlySection('Unanswered items', unanswered)}
        </div>
      `;

      const editor = document.getElementById(`editor-${availabilityOrderId}`)!;
      const readOnly = document.getElementById(`readonly-${availabilityOrderId}`)!;
      const editButton = document.getElementById(`edit-response-${availabilityOrderId}`)!;
      editButton.addEventListener('click', () => {
        editor.classList.remove('hidden');
        readOnly.classList.add('hidden');
        editButton.classList.add('hidden');
      });
      document.getElementById(`cancel-response-${availabilityOrderId}`)?.addEventListener('click', () => {
        editor.classList.add('hidden');
        readOnly.classList.remove('hidden');
        editButton.classList.remove('hidden');
      });
      editor.querySelectorAll<HTMLElement>('.adm-mark-all').forEach((button) => {
        button.addEventListener('click', () => {
          editor.querySelectorAll<HTMLSelectElement>('.adm-avail-select').forEach((select) => {
            select.value = button.dataset.avail || '';
          });
        });
      });
      document.getElementById(`save-response-${availabilityOrderId}`)?.addEventListener('click', async () => {
        const responses: any[] = [];
        editor.querySelectorAll<HTMLSelectElement>('.adm-avail-select').forEach((select) => {
          if (select.value === '') return;
          const commentInput = editor.querySelector<HTMLInputElement>(`.adm-comment[data-id="${select.dataset.id}"]`);
          const comment = commentInput?.value || '';
          if (select.value === select.dataset.orig && comment === (commentInput?.dataset.origComment || '')) return;
          responses.push({
            id: select.dataset.id,
            is_available: select.value === 'true',
            comment: comment || null,
          });
        });
        if (responses.length === 0) {
          const button = document.getElementById(`save-response-${availabilityOrderId}`) as HTMLButtonElement;
          button.textContent = 'No changes to save';
          setTimeout(() => { button.textContent = 'Save responses'; }, 1500);
          return;
        }
        const response = await fetch('/api/availability', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'respond', availability_order_id: availabilityOrderId, responses }),
        });
        if (!response.ok) {
          target.insertAdjacentHTML('afterbegin', '<div class="mb-3 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-300">Failed to save responses.</div>');
          return;
        }
        await loadAvailabilityData();
        document.querySelector<HTMLButtonElement>(`.expand-btn[data-id="${availabilityOrderId}"]`)?.click();
      });
    } catch {
      target.textContent = 'Error loading details.';
    }
  }

  async function loadUnavailableItems(batchId: string, orders: any[]) {
    const container = document.getElementById(`unavailable-${batchId}`);
    const button = document.getElementById(`download-unavailable-${batchId}`) as HTMLButtonElement | null;
    if (!container || !button) return;

    const itemMap = new Map<string, any>();
    const chunkSize = 8;
    for (let index = 0; index < orders.length; index += chunkSize) {
      const chunk = orders.slice(index, index + chunkSize);
      const payloads = await Promise.all(chunk.map(async (order) => {
        const response = await fetch(`/api/availability?id=${order.id}`);
        if (!response.ok) return { order, data: [] };
        const payload = await response.json();
        return { order, data: Array.isArray(payload.data) ? payload.data : [] };
      }));

      for (const { order, data } of payloads) {
        for (const response of data) {
          const barcode = response.order_item?.barcode || 'unknown';
          if (!itemMap.has(barcode)) {
            itemMap.set(barcode, {
              barcode,
              title: response.order_item?.title || '—',
              order_qty: Number(response.order_item?.order_qty || 0),
              companies_asked: [],
              companies_unavailable: [],
            });
          }
          const item = itemMap.get(barcode)!;
          const companyName = order.company?.name || 'Unknown';
          if (!item.companies_asked.includes(companyName)) item.companies_asked.push(companyName);
          if (response.is_available === false && !item.companies_unavailable.includes(companyName)) {
            item.companies_unavailable.push(companyName);
          }
        }
      }
    }

    const unavailable = Array.from(itemMap.values()).filter((item) => item.companies_unavailable.length > 0);
    unavailableByBatch.set(batchId, unavailable);
    button.disabled = unavailable.length === 0;

    if (unavailable.length === 0) {
      container.className = 'px-4 pb-4 text-sm text-gray-500';
      container.textContent = 'No unavailable items found for this batch and filter.';
      return;
    }

    container.className = 'overflow-x-auto px-4 pb-4';
    container.innerHTML = `
      <table class="w-full text-sm rounded-xl overflow-hidden">
        <thead><tr>
          ${['Barcode', 'Title', 'Qty', 'Companies asked', 'Unavailable from', 'All unavailable?'].map((label) => `<th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-gray-400 bg-gray-800/80">${label}</th>`).join('')}
        </tr></thead>
        <tbody>
          ${unavailable.map((item) => {
            const allUnavailable = item.companies_unavailable.length === item.companies_asked.length;
            return `<tr class="border-t border-gray-700/40 ${allUnavailable ? 'bg-red-500/5' : ''}">
              <td class="px-3 py-2 font-mono text-xs text-white">${escapeHtml(item.barcode)}</td>
              <td class="px-3 py-2 text-white">${escapeHtml(item.title)}</td>
              <td class="px-3 py-2 text-right text-white">${item.order_qty}</td>
              <td class="px-3 py-2 text-xs text-gray-300">${escapeHtml(item.companies_asked.join(', '))}</td>
              <td class="px-3 py-2 text-xs text-red-400">${escapeHtml(item.companies_unavailable.join(', '))}</td>
              <td class="px-3 py-2 text-center">${allUnavailable ? '<span class="badge badge-danger">Yes</span>' : '<span class="text-xs text-gray-400">No</span>'}</td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    `;
  }

  function safeSheetName(name: string): string {
    return name.replace(/[:\\/?*\[\]]/g, '_').slice(0, 31) || 'Sheet';
  }

  function downloadUnavailable(batchId: string) {
    const data = unavailableByBatch.get(batchId) || [];
    if (data.length === 0) return;
    const batch = allAvailOrders.find((order) => order.batch_id === batchId)?.batch;
    const workbook = XLSX.utils.book_new();
    const summaryRows = [
      ['Barcode', 'Title', 'Order Qty', '# Companies Asked', '# Unavailable', 'Unavailable From', 'Still Available From', 'All Unavailable'],
      ...data.map((item) => {
        const stillAvailable = item.companies_asked.filter((company: string) => !item.companies_unavailable.includes(company));
        return [
          item.barcode,
          item.title,
          item.order_qty,
          item.companies_asked.length,
          item.companies_unavailable.length,
          item.companies_unavailable.join(', '),
          stillAvailable.join(', '),
          item.companies_unavailable.length === item.companies_asked.length ? 'YES' : 'NO',
        ];
      }),
    ];
    const summarySheet = XLSX.utils.aoa_to_sheet(summaryRows);
    summarySheet['!cols'] = [{ wch: 15 }, { wch: 40 }, { wch: 10 }, { wch: 18 }, { wch: 14 }, { wch: 30 }, { wch: 30 }, { wch: 16 }];
    XLSX.utils.book_append_sheet(workbook, summarySheet, 'Summary');

    const perCompany = new Map<string, any[]>();
    for (const item of data) {
      for (const company of item.companies_unavailable) {
        if (!perCompany.has(company)) perCompany.set(company, []);
        perCompany.get(company)!.push(item);
      }
    }
    for (const company of Array.from(perCompany.keys()).sort()) {
      const rows = [['Barcode', 'Title', 'Order Qty'], ...perCompany.get(company)!.map((item) => [item.barcode, item.title, item.order_qty])];
      const sheet = XLSX.utils.aoa_to_sheet(rows);
      sheet['!cols'] = [{ wch: 15 }, { wch: 40 }, { wch: 10 }];
      XLSX.utils.book_append_sheet(workbook, sheet, safeSheetName(company));
    }
    XLSX.writeFile(workbook, `Unavailable_${String(batch?.name || batchId).replace(/[^a-z0-9_-]+/gi, '_')}.xlsx`);
  }

  function populateCompanyFilter() {
    const select = document.getElementById('availCompanyFilter') as HTMLSelectElement | null;
    if (!select) return;
    const companies = new Map<string, string>();
    for (const order of allAvailOrders) {
      if (order.company?.id && order.company?.name) companies.set(order.company.id, order.company.name);
    }
    select.innerHTML = '<option value="all">All companies</option>' +
      Array.from(companies.entries())
        .sort((a, b) => a[1].localeCompare(b[1]))
        .map(([id, name]) => `<option value="${id}">${escapeHtml(name)}</option>`)
        .join('');
    select.value = companies.has(availCompanyFilter) ? availCompanyFilter : 'all';
  }

  function updateSummary() {
    document.getElementById('totalRequests')!.textContent = String(allAvailOrders.length);
    document.getElementById('fullResponded')!.textContent = String(allAvailOrders.filter((order) => order.status === 'responded').length);
    document.getElementById('pending')!.textContent = String(allAvailOrders.filter((order) => order.status === 'pending').length);
    document.getElementById('unavailableCount')!.textContent = String(allAvailOrders.reduce((sum, order) => sum + Number(order.unavailable_count || 0), 0));
  }

  function updateDeepLinkNotice() {
    const notice = document.getElementById('deepLinkNotice');
    const text = document.getElementById('deepLinkText');
    if (!notice || !text) return;
    if (!forcedBatchId) {
      notice.classList.add('hidden');
      notice.classList.remove('flex');
      return;
    }
    const totalBatches = new Set(allAvailOrders.map((order) => order.batch_id)).size;
    notice.classList.remove('hidden');
    notice.classList.add('flex');
    text.textContent = `Viewing 1 of ${totalBatches} batches`;
  }

  async function loadAvailabilityData() {
    const params = new URLSearchParams({ include: 'batch,pos' });
    const response = await fetch(`/api/availability?${params.toString()}`);
    if (!response.ok) {
      const container = document.getElementById('batchSections');
      if (container) container.innerHTML = '<div class="card py-12 text-center text-red-300">Failed to load availability batches.</div>';
      return;
    }
    const payload = await response.json();
    allAvailOrders = Array.isArray(payload.data) ? payload.data : [];
    updateSummary();
    populateCompanyFilter();
    updateDeepLinkNotice();
    renderSections();
  }

  document.getElementById('availCompanyFilter')?.addEventListener('change', (event) => {
    availCompanyFilter = (event.target as HTMLSelectElement).value || 'all';
    sections.forEach((state) => { state.page = 1; });
    renderSections();
  });
  document.getElementById('availStatusFilter')?.addEventListener('change', (event) => {
    availStatusFilter = (event.target as HTMLSelectElement).value || 'all';
    sections.forEach((state) => { state.page = 1; });
    renderSections();
  });
  document.getElementById('showAllBatches')?.addEventListener('click', () => {
    forcedBatchId = '';
    history.replaceState({}, '', '/availability');
    sections.forEach((state) => {
      state.expanded = false;
      state.loaded = false;
    });
    void loadAvailabilityData();
  });

  void loadAvailabilityData();
</script>
