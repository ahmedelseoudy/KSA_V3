---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import StatCard from '../components/ui/StatCard.astro';

const user = Astro.locals.user;
const profile = (user as any)?.profile;

if (!profile || !['admin', 'super_admin'].includes(profile.role)) {
  return Astro.redirect(profile?.role === 'company' ? '/portal/deliveries' : '/dashboard');
}
---

<Layout title="Delivery Tracking - KSA CRM">
  <div class="max-w-7xl mx-auto">
    <PageHeader
      title="Delivery Tracking"
      subtitle="Record delivered quantities safely and follow fulfillment batch by batch"
    />

    <div class="sticky top-0 z-20 -mx-1 px-1 py-2 bg-gray-950/80 backdrop-blur mb-4">
      <div class="flex flex-wrap items-end gap-3 bg-gray-800/60 border border-gray-700/60 rounded-xl p-3">
        <div>
          <label for="companyFilter" class="block text-xs text-gray-500 mb-1">Company</label>
          <select id="companyFilter" class="input min-w-[12rem]">
            <option value="">All companies</option>
          </select>
        </div>
        <div>
          <label for="statusFilter" class="block text-xs text-gray-500 mb-1">PO status</label>
          <select id="statusFilter" class="input min-w-[11rem]">
            <option value="">All active POs</option>
            <option value="sent">Sent</option>
            <option value="confirmed">Confirmed</option>
            <option value="partially_delivered">Partially delivered</option>
            <option value="delivered">Delivered</option>
          </select>
        </div>
        <button id="refreshButton" class="btn btn-secondary btn-md">Refresh</button>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-6">
      <StatCard label="Purchase orders" valueId="totalDeliveries" />
      <StatCard label="Ordered value" valueId="orderedValue" valueClass="text-green-400" />
      <StatCard label="Delivered value" valueId="deliveredValue" valueClass="text-blue-400" />
      <StatCard label="Overdue" valueId="overdueCount" valueClass="text-red-400" />
      <StatCard label="Quantity fill rate" valueId="fillRate" valueClass="text-orange-400" />
    </div>

    <div class="mb-4 rounded-xl border border-blue-500/30 bg-blue-500/10 px-4 py-3 text-sm text-blue-300">
      Delivered quantities start at their saved values. Nothing is submitted until you change a quantity or note and click Save.
    </div>

    <div id="deliveryBatches" class="space-y-4" aria-live="polite">
      <div class="card p-10 text-center text-gray-500 animate-pulse">Loading delivery lifecycle…</div>
    </div>
  </div>
</Layout>

<script>
  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function money(value: unknown): string {
    return new Intl.NumberFormat(undefined, {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    }).format(Number(value || 0));
  }

  function date(value: unknown): string {
    if (!value) return 'Not scheduled';
    const parsed = new Date(String(value));
    return Number.isNaN(parsed.getTime()) ? 'Not scheduled' : parsed.toLocaleDateString();
  }

  function statusBadge(status: string): string {
    const classes: Record<string, string> = {
      sent: 'badge-info',
      confirmed: 'badge-brand',
      partially_delivered: 'badge-warning',
      delivered: 'badge-success',
      cancelled: 'badge-danger',
    };
    return `<span class="badge ${classes[status] || 'badge-pending'}">${escapeHtml(status.replace(/_/g, ' '))}</span>`;
  }

  async function loadCompanies() {
    const resp = await fetch('/api/companies');
    if (!resp.ok) return;
    const { data } = await resp.json();
    const select = document.getElementById('companyFilter') as HTMLSelectElement;
    select.innerHTML = `<option value="">All companies</option>${(data || [])
      .map((company: any) => `<option value="${escapeHtml(company.id)}">${escapeHtml(company.name)}</option>`)
      .join('')}`;
  }

  function renderSummary(summary: any) {
    document.getElementById('totalDeliveries')!.textContent = String(summary?.purchase_orders || 0);
    document.getElementById('orderedValue')!.textContent = money(summary?.ordered_value);
    document.getElementById('deliveredValue')!.textContent = money(summary?.delivered_value);
    document.getElementById('overdueCount')!.textContent = String(summary?.overdue || 0);
    document.getElementById('fillRate')!.textContent = `${Number(summary?.fill_rate || 0).toFixed(1)}%`;
  }

  function renderPORow(row: any): string {
    const po = row.po;
    const fill = Number(row.ordered_qty || 0) > 0
      ? Math.min(100, (Number(row.delivered_qty || 0) / Number(row.ordered_qty || 0)) * 100)
      : 0;
    return `
      <tr class="border-t border-gray-700/40 hover:bg-gray-800/40 transition-colors">
        <td class="px-4 py-3">
          <div class="font-medium text-gray-100">${escapeHtml(row.company_name || po.company?.name || 'Unknown company')}</div>
          <div class="text-xs text-gray-500 mt-1">${escapeHtml(po.company?.email || '')}</div>
        </td>
        <td class="px-4 py-3">
          <div class="font-mono text-gray-100">${escapeHtml(po.po_number || '—')}</div>
          <div class="mt-2">${statusBadge(po.status)}</div>
        </td>
        <td class="px-4 py-3 text-right">
          <div class="text-gray-100 tabular-nums">${money(row.ordered_value)}</div>
          <div class="text-xs text-gray-500 mt-1">${Number(row.ordered_qty || 0)} units</div>
        </td>
        <td class="px-4 py-3 min-w-[12rem]">
          <div class="flex justify-between text-xs text-gray-400 mb-1">
            <span>${Number(row.delivered_qty || 0)}/${Number(row.ordered_qty || 0)} units</span>
            <span>${fill.toFixed(0)}%</span>
          </div>
          <div class="h-1.5 rounded-full bg-gray-700 overflow-hidden">
            <div class="h-full bg-orange-500 rounded-full" style="width:${fill}%"></div>
          </div>
          <div class="text-xs ${row.is_overdue ? 'text-red-400' : 'text-gray-500'} mt-1">
            ${row.is_overdue ? 'Overdue · ' : ''}${date(row.delivery_date)}
          </div>
        </td>
        <td class="px-4 py-3">
          <button
            class="edit-delivery btn btn-secondary btn-sm"
            data-po-id="${escapeHtml(po.id)}"
            aria-expanded="false"
            aria-controls="delivery-items-${escapeHtml(po.id)}"
          >Edit quantities</button>
        </td>
      </tr>
      <tr id="delivery-items-${escapeHtml(po.id)}" class="hidden bg-gray-900/40" data-loaded="false">
        <td colspan="5" class="px-4 py-4">
          <div id="delivery-items-content-${escapeHtml(po.id)}" class="text-sm text-gray-500 animate-pulse">Loading items…</div>
        </td>
      </tr>
    `;
  }

  function renderBatch(group: any, index: number): string {
    const rows = (group.rows || []).filter((row: any) => row.po && row.po.status !== 'cancelled');
    if (rows.length === 0) return '';
    const orderedValue = rows.reduce((sum: number, row: any) => sum + Number(row.ordered_value || 0), 0);
    const deliveredValue = rows.reduce((sum: number, row: any) => sum + Number(row.delivered_value || 0), 0);
    const overdue = rows.filter((row: any) => row.is_overdue).length;
    const expanded = index < 3;
    return `
      <section class="card overflow-hidden">
        <button class="batch-toggle w-full p-4 flex flex-col md:flex-row md:items-center justify-between gap-3 text-left hover:bg-gray-800/30" aria-expanded="${expanded}" aria-controls="delivery-batch-${escapeHtml(group.batch.id)}">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-base font-semibold text-gray-100">${escapeHtml(group.batch.name || 'Unknown batch')}</h2>
              ${overdue ? `<span class="badge badge-danger">${overdue} overdue</span>` : ''}
            </div>
            <p class="text-xs text-gray-500 mt-1">${rows.length} purchase orders</p>
          </div>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-gray-400">${money(deliveredValue)} / ${money(orderedValue)} delivered</span>
            <span class="batch-icon text-gray-400 text-lg">${expanded ? '−' : '+'}</span>
          </div>
        </button>
        <div id="delivery-batch-${escapeHtml(group.batch.id)}" class="${expanded ? '' : 'hidden'} border-t border-gray-700/60">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr>
                  <th class="table-header-cell text-left">Company</th>
                  <th class="table-header-cell text-left">Purchase order</th>
                  <th class="table-header-cell text-right">Ordered</th>
                  <th class="table-header-cell text-left">Fulfillment</th>
                  <th class="table-header-cell text-left">Action</th>
                </tr>
              </thead>
              <tbody>${rows.map(renderPORow).join('')}</tbody>
            </table>
          </div>
        </div>
      </section>
    `;
  }

  function itemEditor(poId: string, items: any[]): string {
    if (items.length === 0) return '<div class="text-gray-500">No items in this purchase order.</div>';
    return `
      <div class="overflow-x-auto rounded-lg border border-gray-700/40">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th class="table-header-cell text-left">Product</th>
              <th class="table-header-cell text-right">Ordered</th>
              <th class="table-header-cell text-right">Delivered</th>
              <th class="table-header-cell text-left">Notes</th>
              <th class="table-header-cell text-left">State</th>
            </tr>
          </thead>
          <tbody>
            ${items.map((item: any) => {
              const delivered = Number(item.delivered_qty ?? 0);
              const notes = String(item.delivery_notes || '');
              return `
                <tr class="delivery-item border-t border-gray-700/40" data-item-id="${escapeHtml(item.id)}">
                  <td class="px-3 py-2 text-gray-100">${escapeHtml(item.product?.title || item.product?.barcode || '—')}</td>
                  <td class="px-3 py-2 text-right text-gray-200 tabular-nums">${Number(item.quantity || 0)}</td>
                  <td class="px-3 py-2 text-right">
                    <input
                      type="number"
                      class="delivered-input input w-24 text-right tabular-nums"
                      data-item-id="${escapeHtml(item.id)}"
                      data-original="${delivered}"
                      data-delivery-status="${escapeHtml(item.delivery_status || 'pending')}"
                      value="${delivered}"
                      min="0"
                      max="${Number(item.quantity || 0)}"
                    />
                  </td>
                  <td class="px-3 py-2">
                    <input
                      type="text"
                      class="notes-input input min-w-[14rem]"
                      data-item-id="${escapeHtml(item.id)}"
                      data-original="${escapeHtml(notes)}"
                      value="${escapeHtml(notes)}"
                      placeholder="Delivery notes"
                    />
                  </td>
                  <td class="px-3 py-2">${statusBadge(item.delivery_status || 'pending')}</td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-end gap-3">
        <span id="save-status-${escapeHtml(poId)}" class="text-sm text-gray-500"></span>
        <button class="save-deliveries btn btn-primary btn-md" data-po-id="${escapeHtml(poId)}">Save changed items</button>
      </div>
    `;
  }

  async function loadPOItems(poId: string) {
    const target = document.getElementById(`delivery-items-content-${poId}`);
    if (!target) return;
    try {
      const resp = await fetch(`/api/purchase-orders?id=${encodeURIComponent(poId)}&items=true`);
      const json = await resp.json();
      if (!resp.ok) throw new Error(json.error || 'Request failed');
      target.classList.remove('animate-pulse');
      target.innerHTML = itemEditor(poId, Array.isArray(json.data) ? json.data : []);
      target.querySelector('.save-deliveries')?.addEventListener('click', () => saveChangedItems(poId));
    } catch (error) {
      target.classList.remove('animate-pulse');
      target.textContent = error instanceof Error ? error.message : 'Failed to load items.';
    }
  }

  function changedItems(poId: string): { items: any[]; error: string | null } {
    const target = document.getElementById(`delivery-items-content-${poId}`);
    if (!target) return { items: [], error: 'Editor not found.' };
    const items: any[] = [];
    for (const row of target.querySelectorAll<HTMLElement>('.delivery-item')) {
      const quantity = row.querySelector<HTMLInputElement>('.delivered-input')!;
      const notes = row.querySelector<HTMLInputElement>('.notes-input')!;
      const delivered = Number(quantity.value);
      const max = Number(quantity.max);
      if (!Number.isInteger(delivered) || delivered < 0 || delivered > max) {
        return { items: [], error: `Delivered quantity must be a whole number between 0 and ${max}.` };
      }
      if (
        delivered !== Number(quantity.dataset.original || 0) ||
        notes.value !== (notes.dataset.original || '')
      ) {
        items.push({
          id: row.dataset.itemId,
          delivered_qty: delivered,
          delivery_notes: notes.value,
        });
      }
    }
    return { items, error: null };
  }

  async function saveChangedItems(poId: string) {
    const status = document.getElementById(`save-status-${poId}`)!;
    const changes = changedItems(poId);
    if (changes.error) {
      status.className = 'text-sm text-red-400';
      status.textContent = changes.error;
      return;
    }
    if (changes.items.length === 0) {
      status.className = 'text-sm text-gray-500';
      status.textContent = 'No changes to save.';
      return;
    }

    status.className = 'text-sm text-gray-500';
    status.textContent = 'Saving…';
    const resp = await fetch('/api/purchase-orders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'update_delivery', items: changes.items }),
    });
    const json = await resp.json().catch(() => ({}));
    if (!resp.ok) {
      status.className = 'text-sm text-red-400';
      status.textContent = json.error || 'Failed to save deliveries.';
      return;
    }

    status.className = 'text-sm text-green-400';
    status.textContent = `Saved ${changes.items.length} changed ${changes.items.length === 1 ? 'item' : 'items'}.`;
    await loadDeliveries(poId);
  }

  function wireActions() {
    document.querySelectorAll('.batch-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const target = document.getElementById(button.getAttribute('aria-controls') || '');
        if (!target) return;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        target.classList.toggle('hidden', expanded);
        const icon = button.querySelector('.batch-icon');
        if (icon) icon.textContent = expanded ? '+' : '−';
      });
    });

    document.querySelectorAll('.edit-delivery').forEach((button) => {
      button.addEventListener('click', async () => {
        const poId = (button as HTMLElement).dataset.poId;
        if (!poId) return;
        const row = document.getElementById(`delivery-items-${poId}`);
        if (!row) return;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        button.textContent = expanded ? 'Edit quantities' : 'Close editor';
        row.classList.toggle('hidden', expanded);
        if (!expanded && row.dataset.loaded !== 'true') {
          await loadPOItems(poId);
          row.dataset.loaded = 'true';
        }
      });
    });
  }

  async function loadDeliveries(focusPo = '') {
    const container = document.getElementById('deliveryBatches')!;
    container.innerHTML = '<div class="card p-10 text-center text-gray-500 animate-pulse">Loading delivery lifecycle…</div>';
    const params = new URLSearchParams({ view: 'lifecycle' });
    const company = (document.getElementById('companyFilter') as HTMLSelectElement)?.value;
    const status = (document.getElementById('statusFilter') as HTMLSelectElement)?.value;
    if (company) params.set('company_id', company);
    if (status) params.set('status', status);

    try {
      const resp = await fetch(`/api/purchase-orders?${params}`);
      const json = await resp.json();
      if (!resp.ok) throw new Error(json.error || 'Request failed');
      renderSummary(json.summary);
      const groups = (json.batches || []).filter((group: any) =>
        (group.rows || []).some((row: any) => row.po && row.po.status !== 'cancelled')
      );
      container.innerHTML = groups.length
        ? groups.map(renderBatch).join('')
        : '<div class="card p-10 text-center text-gray-400">No purchase orders match these filters.</div>';
      wireActions();
      if (focusPo) {
        const button = container.querySelector<HTMLButtonElement>(`.edit-delivery[data-po-id="${CSS.escape(focusPo)}"]`);
        button?.click();
        button?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch (error) {
      container.innerHTML = `<div class="card p-10 text-center text-red-400">${escapeHtml(error instanceof Error ? error.message : 'Failed to load deliveries.')}</div>`;
    }
  }

  document.getElementById('companyFilter')?.addEventListener('change', () => loadDeliveries());
  document.getElementById('statusFilter')?.addEventListener('change', () => loadDeliveries());
  document.getElementById('refreshButton')?.addEventListener('click', () => loadDeliveries());

  loadCompanies();
  loadDeliveries(new URLSearchParams(window.location.search).get('po_id') || '');
</script>
